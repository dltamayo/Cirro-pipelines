profiles {
    standard {
        process {
            errorStrategy = 'retry'
            maxRetries = 2
        }
    }
}

process {
    withName: '.*ALIGN_STAR:PARABRICKS_RNA_FQ2BAM' {
        accelerator   = { task.attempt == 1 ? 2 : 4 }
        cpus          = { task.attempt == 1 ? 24 : 48 }
        memory        = { task.attempt == 1 ? 186.GB : 370.GB }
        time          = 24.h
        queue         = env('PW_ONDEMAND_JOB_QUEUE')
        errorStrategy = { task.exitStatus in [1, 2, 104, 134, 137, 139, 143, 255] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // Parabricks marks duplicates during alignment, so Picard MarkDuplicates (the usual publisher
    // of the final BAM) does not run. Publish the sorted BAM and index directly in that case.
    withName: 'NFCORE_RNASEQ:RNASEQ:.*:BAM_SORT_STATS_SAMTOOLS:(SAMTOOLS_SORT|SAMTOOLS_INDEX)' {
        publishDir = [
            path: { params.save_align_intermeds || params.skip_markduplicates || params.use_parabricks_star ? "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" : params.outdir },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bai,csi}",
            saveAs: { filename -> params.save_align_intermeds || params.skip_markduplicates || params.use_parabricks_star ? filename : null }
        ]
    }
}

process.shell = [
    "bash",
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]
